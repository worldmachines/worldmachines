{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "worldmachines",
  "compatibility_date": "2026-05-12",
  "pages_build_output_dir": ".",
  "kv_namespaces": [
    {
      "binding": "HANDLES",
      "id": "fc2ed69d95644b8298777e3318240e1c"
    },
    {
      "binding": "MCP_TOKENS",
      "id": "aea826a3169149fea80afba8fbba20a2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NOTES",
      "bucket_name": "worldmachines-notes"
    },
    {
      "binding": "LIBRARY",
      "bucket_name": "worldmachines-library"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Deliberately still a workers.dev hostname, and not oracle.worldmachines.org.
    //
    // This is server-side only: functions/api/ask.js and stats.js fetch it, the
    // browser never sees it (that is the whole point of the /api/ask proxy). So
    // it carries none of the branding problem the 2026-08-27 move fixed on
    // worldmachines.org/mcp, where the URL is handed to readers to paste into
    // their own MCP config.
    //
    // What it would carry is the 524. A Worker on a custom domain "is treated as
    // an origin", so the request rides the zone proxy and is killed if no
    // response headers appear inside the Proxy Read Timeout (~125s, Enterprise-
    // only to raise). A *.workers.dev request never enters the zone. Prime
    // Radiant learned this on 2026-08-10 — "The trunk did not answer. 524" — and
    // its ask.js is pinned to workers.dev for the same reason.
    //
    // oracle.worldmachines.org exists and works; use it for anything a human
    // reads. Leave this one alone until Oracle answers stream.
    "ORACLE_URL": "https://wm-oracle-dev.aneeshsathe.workers.dev"
  }
}
