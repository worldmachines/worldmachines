# Local development only. `wrangler dev` loads this file; `wrangler deploy` NEVER
# uploads it. It is committed on purpose so `npx wrangler dev` works with no setup.
#
# NEVER PUT A REAL SECRET IN HERE. Secrets go through `wrangler secret put`, which
# stores them on the Worker and never in the repo. If you ever need a real value
# locally, add `apps/scribe/.dev.vars` to the repo .gitignore first.
#
# DEV_USER_EMAIL fakes the `Cf-Access-Authenticated-User-Email` header that
# Cloudflare Access injects in production. It is ignored the moment ACCESS_TEAM_DOMAIN
# and ACCESS_AUD are configured (see wrangler.jsonc), so it cannot weaken a deploy.
DEV_USER_EMAIL = "dev@worldmachines.local"

# With an empty local KV there is no HANDLES record for that email, so these stand in
# for one. Change DEV_HANDLE to test as another member (try "vgr" — it maps to
# raw-notes/venkat/).
DEV_HANDLE = "aneesh"
DEV_NAME = "Dev User"
